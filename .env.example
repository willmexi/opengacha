# ---- Cluster --------------------------------------------------------------
# Unset = devnet (free): sells pools.devnet.json, reads Solana's public devnet
# endpoint (or DEVNET_RPC_URL), explorer links land on devnet.
# `mainnet` sells pools.json through RPC_URL, for real money.
# NEXT_PUBLIC_CLUSTER=mainnet
# DEVNET_RPC_URL=

# ---- RPC ------------------------------------------------------------------
# Mainnet only. Your own Solana mainnet RPC (Helius, QuickNode, Triton...). The browser
# never sees this: it talks to this app's /api/rpc proxy, which forwards
# here. The public endpoint works for a look around and rate-limits fast.
RPC_URL=https://api.mainnet-beta.solana.com

# Optional: a browser-safe RPC. If set, the browser calls it directly
# (skipping the proxy). Only use an endpoint you are happy to expose.
# NEXT_PUBLIC_RPC=

# ---- Local database -------------------------------------------------------
# SQLite file for the mini-mirror (positions, card metadata, images).
# Created on first run. Relative to the project root.
DATABASE_PATH=./data/opengacha.db

# ---- Optional -------------------------------------------------------------
# The OpenGacha directory (opengacha.io's api): pull volume and socials for
# the builder panel. Colour, not money; the app works without it.
# Card pictures come from OpenGacha's art shelf when the directory api
# answers (one fetch ever per card, served from their image domain); set 0
# to keep every picture on the URL its own metadata gives.
# ART_SHELF=1
# DIRECTORY_API=https://nfw-api-560813787781.us-east1.run.app
